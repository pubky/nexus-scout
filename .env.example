# nexus-scout configuration (12-factor; every var is optional and has a default).
# These override the built-in defaults; the --neo4j-uri flag in turn overrides
# NEO4J_URI (it is the only setting with a CLI override).

# --- Neo4j connection (use the read-only reader role in production) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Allow plaintext Bolt to a non-loopback host even under NEXUS_SCOUT_PROFILE=production
# (otherwise refused). Only set this when Neo4j is reachable solely over a trusted
# private link, e.g. an isolated Docker network with no published DB port.
NEO4J_ALLOW_INSECURE_TRANSPORT=false

# --- Guardrails ---
# Max characters of the incoming Cypher (checked after Unicode normalization).
MAX_QUERY_LENGTH=2000
# Default LIMIT applied when the caller does not request one.
DEFAULT_LIMIT=25
# Caps rows returned (not server-side work), regardless of any LIMIT in the query.
MAX_RESULT_ROWS=100
# Cap on the summed returned-row payload bytes; a row that would exceed it is dropped
# (flagged truncated). The response envelope adds a small fixed overhead on top.
MAX_RESULT_BYTES=1048576
# Client-side liveness timeout in milliseconds.
QUERY_TIMEOUT_MS=10000
# Variable-length relationship paths are capped at this depth (e.g. *1..5).
MAX_PATH_DEPTH=5
# Param-payload DoS bounds.
MAX_PARAM_COUNT=32
MAX_PARAM_BYTES=8192
MAX_PARAM_DEPTH=8

# --- HTTP server (only used by `nexus-scout serve --transport http`) ---
# Bind address. Default is loopback (safe-by-default); behind a reverse proxy in
# a container, set 0.0.0.0:8080 on the private network.
HTTP_ADDR=127.0.0.1:8080
# Max request body size in bytes; a larger body is rejected with 413.
HTTP_MAX_BODY_BYTES=65536
# Max in-flight /v1/query requests; excess is shed with 429.
HTTP_MAX_CONCURRENCY=64
# Max sustained /v1/query requests per second; excess is shed with 429.
HTTP_MAX_RPS=50
# Whole-request wall-clock timeout (ms); a backstop above QUERY_TIMEOUT_MS.
HTTP_REQUEST_TIMEOUT_MS=30000
# Deployment profile: `development` (warn on misconfig) or `production` (fail closed).
NEXUS_SCOUT_PROFILE=development

# --- Logging / client ---
RUST_LOG=nexus_scout=info,warn
# `scout` client: base URL of the gateway (overridden by --server-url).
NEXUS_SCOUT_URL=http://localhost:8080
